# EdgeX SDK V2 Configuration Example
# This SDK only supports V2 API with HMAC authentication


# Required: API Base Configuration
EDGEX_BASE_URL=https://edgex-prod-v2.edgex.exchange
EDGEX_ACCOUNT_ID=your_account_id_here

# Required: HMAC Authentication Credentials
EDGEX_API_KEY=your_api_key_here
EDGEX_API_SECRET=your_api_secret_here
EDGEX_API_PASSPHRASE=your_api_passphrase_here

# Required: EIP-712 Signing Private Keys
EDGEX_SIGNER_ADDRESS=your_signer_address_here
EDGEX_SIGNER_PRIVATE_KEY=your_signer_private_key_here

# Optional: Wallet private key for withdrawal creation
EDGEX_WALLET_ADDRESS=your_wallet_address_here
EDGEX_WALLET_PRIVATE_KEY=your_wallet_private_key_here

# Optional: WebSocket Configuration
EDGEX_WS_BASE_URL=wss://edgex-quote-prod-v2.edgex.exchange

# Optional: Enable Mutation Tests (creates real orders/withdrawals)
# EDGEX_ENABLE_MUTATION_TESTS=false
